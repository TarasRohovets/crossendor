# Copy to .env and fill in what you have. Restart after changes:  docker compose up -d

# Anthropic: Claude writes the store. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# true = placeholder results, no AI calls. The real steps are not built yet, so keep it on for now.
AI_USE_MOCK=true

# Port the app is served on.
WEB_PORT=3000

# Who can reach the app. 127.0.0.1 = only this computer (recommended: there is no sign-in).
BIND_ADDRESS=127.0.0.1

# Database password (only reachable inside the Docker network). Required: pick any long random string.
POSTGRES_PASSWORD=
